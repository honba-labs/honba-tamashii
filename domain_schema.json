                  "description": "Local ingestion receive timestamp",
                  "format": "date-time",
                  "type": "string"
                },
                "volume": {
                  "description": "Cumulative volume or last traded quantity",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
