                  "description": "Best bid quantity",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                  "type": "string"
                },
                "exchange_ts": {
                  "description": "Exchange timestamp",
                  "format": "date-time",
                  "type": "string"
                },
                "instrument": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/InstrumentId"
                    }
                  ],
                  "description": "Canonical instrument ID"
                },
                "last_price": {
                  "description": "Last traded price (if available)",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "receive_ts": {
                  "description": "Local ingestion receive timestamp",
                  "format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "ask",
                "ask_qty",
                "bid",
                "bid_qty",
                "exchange_ts",
                "instrument",
                "receive_ts"
              ],
              "type": "object"
            },
            "type": {
              "enum": [
                "quote"
              ],
              "type": "string"
            }
          },
          "required": [
            "data",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Full market depth tick (L2).",
